# ---------------------------------------------------------------------------
# 递我 · Send to Me — environment defaults
# Copy to .env, adjust, then run with `make run` (the Makefile loads .env).
# ---------------------------------------------------------------------------

ADDR=:8080
# Enables /admin. Leave empty to keep the admin console disabled.
ADMIN_PASSWORD=
DATA_DIR=./data
# Set this when running behind a reverse proxy or on a custom domain.
PUBLIC_BASE_URL=http://localhost:8080
# Only enable when a trusted reverse proxy sets X-Forwarded-For / X-Real-IP.
TRUST_PROXY=false

MAX_UPLOAD_MB=2048
MAX_FILES=20
MAX_TEXT_KB=64
CLEANUP_GRACE_HOURS=24

# ---------------------------------------------------------------------------
# Storage — local disk (default)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/files

# ---------------------------------------------------------------------------
# Storage — S3-compatible object storage
#
# Provider presets: aws | r2 | aliyun | tencent | huawei | qiniu | backblaze
#                   | minio | custom
# Reads are proxied by the app, so the bucket can stay private.
# ---------------------------------------------------------------------------
# STORAGE_DRIVER=s3
# S3_PROVIDER=aws
# S3_REGION=us-east-1
# S3_BUCKET=my-send-to-me-bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_PREFIX=send-to-me
# Optional for AWS; required for minio/custom.
# S3_ENDPOINT=
# Required for Cloudflare R2 when S3_ENDPOINT is not set.
# S3_ACCOUNT_ID=
# Override the provider's default addressing style (true/false).
# S3_FORCE_PATH_STYLE=

# Cloudflare R2 example:
# STORAGE_DRIVER=s3
# S3_PROVIDER=r2
# S3_ACCOUNT_ID=your_cloudflare_account_id
# S3_BUCKET=send-to-me
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=auto

# Alibaba Cloud OSS example (virtual-hosted style):
# STORAGE_DRIVER=s3
# S3_PROVIDER=aliyun
# S3_REGION=cn-hangzhou
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...

# MinIO example (path-style):
# STORAGE_DRIVER=s3
# S3_PROVIDER=minio
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=send-to-me
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
